# Copia este archivo a agents/investigador/.env (está en .gitignore, nunca
# se sube) y pon tu key real. Lo que no definas aquí se toma del
# baseline/.env (LM_STUDIO_MODEL_ID, OPENAI_API_BASE, OPENAI_API_KEY).

# Key de Tavily: https://app.tavily.com (plan gratuito, 1,000 créditos al mes).
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# Backend de search_web: "tavily" (búsqueda real, default) o "stub"
# (resultados de ejemplo, sin internet ni key; solo para probar estructura).
SEARCH_BACKEND=tavily
