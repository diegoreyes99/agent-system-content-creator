# Copy to agents/shared/.env (ignored by git).

# Service account key (a secret). Lives outside the project, git and iCloud.
GOOGLE_SERVICE_ACCOUNT_FILE=~/.config/dopa/google_service_account.json

# "Parrilla DOPA" spreadsheet: the part of its URL between /d/ and /edit.
# Not a secret, but only the accounts it is shared with can open it.
PARRILLA_SPREADSHEET_ID=your-spreadsheet-id
