# Copia este archivo a .env (que esta en .gitignore, nunca se sube) y
# ajusta los valores si los tuyos son distintos a los defaults del script.

# Identificador EXACTO del modelo tal como lo expone LM Studio -- se ve en
# la pestana "Developer" / "Local Server" de LM Studio, no es libre.
LM_STUDIO_MODEL_ID=qwen3-4b-instruct-2507

# Servidor local de LM Studio (OpenAI-compatible). Cambia el puerto si en
# tu instalacion LM Studio usa otro.
OPENAI_API_BASE=http://localhost:1234/v1

# LM Studio no valida esta key -- solo exige que la variable exista.
OPENAI_API_KEY=lm-studio
